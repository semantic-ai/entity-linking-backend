@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix mu:   <http://mu.semte.ch/vocabularies/core/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix task: <http://redpencil.data.gift/vocabularies/tasks/> .

<http://example.org/test/task/link-nominatim>
    a task:Task ;
    mu:uuid "test-task-link-nominatim" ;
    adms:status <http://redpencil.data.gift/id/concept/JobStatus/scheduled> ;
    task:operation <http://lblod.data.gift/id/jobs/concept/TaskOperation/named-entity-linking> ;
    dct:isPartOf <http://example.org/test/job/link-nominatim> ;
    task:inputContainer <http://example.org/test/container/link-nominatim> .

<http://example.org/test/container/link-nominatim>
    task:hasResource <http://example.org/test/annotation/link-nominatim> .

<http://example.org/test/task/link-nominatim-first>
    a task:Task ;
    dct:isPartOf <http://example.org/test/job/link-nominatim> ;
    task:index "0" ;
    task:inputContainer <http://example.org/test/container/link-nominatim-first> .

<http://example.org/test/container/link-nominatim-first>
    task:hasResource <http://example.org/test/governing-unit/gent> .

<http://example.org/test/governing-unit/gent>
    skos:prefLabel "Gent" .

<http://example.org/test/annotation/link-nominatim>
    oa:motivatedBy oa:linking ;
    oa:hasBody <http://example.org/test/statement/link-nominatim> ;
    oa:hasTarget <http://example.org/test/target/link-nominatim> .

<http://example.org/test/statement/link-nominatim>
    rdf:object <http://example.org/test/entity/link-nominatim> .

<http://example.org/test/entity/link-nominatim>
    a dct:Location ;
    rdfs:label "Kerkstraat" .
