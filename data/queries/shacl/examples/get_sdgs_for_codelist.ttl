PREFIX ext: <http://mu.semte.ch/vocabularies/ext/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX oa: <http://www.w3.org/ns/oa#>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT DISTINCT
  ?annotation
  ?expression
  ?concept
  ?codelist
  ?activity
  ?agent
  ?work
  ?org
  ?participant
WHERE {

  VALUES ?participant {
    <http://data.lblod.info/id/bestuurseenheden/353234a365664e581db5c2f7cc07add2534b47b8e1ab87c821fc6e6365e6bef5>
  }

  VALUES ?codelist {
    <http://data.lblod.info/id/conceptschemes/sdg-simple>
    <http://mu.semte.ch/vocabularies/ext/impact>
  }

  ?annotation oa:hasBody ?concept .
  ?annotation oa:hasTarget ?expression .

  ?concept skos:inScheme ?codelist .

  OPTIONAL {
    ?activity prov:generated ?annotation .

    OPTIONAL {
      ?activity prov:wasAssociatedWith ?agent .
    }
  }

  {
    ?work eli:is_realized_by ?expression .
    ?work eli:passed_by ?org .
    ?participant org:hasSubOrganization* ?org .
  }
  UNION {
    ?expression ext:owningBody ?participant .
  }
}