@prefix ex: <http://virtuoso:8890/.well-known/sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

_:sparql_examples_prefixes
    a owl:Ontology ;
    sh:declare
        [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ],
        [ sh:prefix "org" ; sh:namespace "http://www.w3.org/ns/org#"^^xsd:anyURI ],
        [ sh:prefix "euvoc" ; sh:namespace "http://publications.europa.eu/ontology/euvoc#"^^xsd:anyURI ],
        [ sh:prefix "oa" ; sh:namespace "http://www.w3.org/ns/oa#"^^xsd:anyURI ],
        [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ],
        [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ],
        [ sh:prefix "eli" ; sh:namespace "http://data.europa.eu/eli/ontology#"^^xsd:anyURI ],
        [ sh:prefix "eli-dl" ; sh:namespace "http://data.europa.eu/eli/eli-draft-legislation-ontology#"^^xsd:anyURI ],
        [ sh:prefix "nif" ; sh:namespace "http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#"^^xsd:anyURI ],
        [ sh:prefix "ext" ; sh:namespace "http://mu.semte.ch/vocabularies/ext/"^^xsd:anyURI ],
        [ sh:prefix "mu" ; sh:namespace "http://mu.semte.ch/vocabularies/core/"^^xsd:anyURI ] .

ex:001
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Get all the administrative bodies (URIs, label) of region 'Sint-Gillis-Waas'"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """SELECT ?administrativeBody ?administrativeBodyLabel WHERE {
  ?administrativeBody a org:Organization ;
          skos:prefLabel ?administrativeBodyLabel ;
          euvoc:represents ?administrativeUnit .

  ?administrativeUnit a org:Organization ;
           skos:prefLabel ?regionLabel .

  FILTER(CONTAINS(LCASE(STR(?regionLabel)), LCASE("Sint-Gillis-Waas"))) .
  FILTER(lang(?administrativeBodyLabel) = "nl") .
  FILTER(lang(?regionLabel) = "nl") .
}
LIMIT 100""" ;
    schema:keywords "administrativeBody", "region", "Sint-Gillis-Waas" ;
    schema:target <https://human-validator.decide.lblod.info/api/sparql> .

ex:002
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Get the administrative body URI of a region 'Gent' with label 'Vast Bureau'"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """SELECT ?administrativeBody ?administrativeBodyLabel WHERE {
  ?administrativeBody a org:Organization ;
          skos:prefLabel ?administrativeBodyLabel ;
          euvoc:represents ?administrativeUnit .

  ?administrativeUnit a org:Organization ;
           skos:prefLabel ?regionLabel .

  FILTER(CONTAINS(LCASE(STR(?regionLabel)), LCASE("Gent"))) .
  FILTER(CONTAINS(LCASE(STR(?administrativeBodyLabel)), LCASE("Vast Bureau"))) .
  FILTER(lang(?administrativeBodyLabel) = "nl") .
  FILTER(lang(?regionLabel) = "nl") .
}
LIMIT 10""" ;
    schema:keywords "administrativeBody", "region", "Gent", "Vast Bureau" ;
    schema:target <https://human-validator.decide.lblod.info/api/sparql> .

ex:003
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment """Welke mandatarissen waren er betrokken bij de besluiten in een bepaalde gemeente (bv. Gent)?
Zoekt via oa:Annotation met motivatie oa:linking en rdf:Statement met predicaat eli-dl:had_participant_person.
De annotatie-target (oa:SpecificResource) verwijst naar de eli:Expression waaruit de persoon is geëxtraheerd.
De Expression is gekoppeld aan een eli:Work via eli:is_realized_by, en het Work aan een org:Organization via eli:passed_by.
Het bestuursorgaan is via euvoc:represents gekoppeld aan de gemeente/regio."""@nl ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """SELECT DISTINCT ?personLabel (COUNT(DISTINCT ?expression) AS ?aantalBesluiten) WHERE {
  ?annotation a oa:Annotation ;
    oa:motivatedBy oa:linking ;
    oa:hasBody ?stmt ;
    oa:hasTarget ?target .

  ?stmt a rdf:Statement ;
    rdf:predicate eli-dl:had_participant_person ;
    rdf:object ?person .

  ?person rdfs:label ?personLabel .

  ?target oa:hasSource ?expression .

  ?work eli:is_realized_by ?expression ;
        eli:passed_by ?adminBody .

  ?adminBody euvoc:represents ?region .
  ?region skos:prefLabel ?regionLabel .
  FILTER(CONTAINS(LCASE(STR(?regionLabel)), LCASE("Gent")))
  FILTER(lang(?regionLabel) = "nl")
}
GROUP BY ?personLabel
ORDER BY DESC(?aantalBesluiten)
LIMIT 20""" ;
    schema:keywords "mandataris", "participant", "persoon", "besluit", "Gent", "betrokken" ;
    schema:target <https://human-validator.decide.lblod.info/api/sparql> .

ex:004
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment """Hoeveel besluiten hadden een positieve impact op milieu (SDG-13 Climate Action) in een bepaalde gemeente?
Zoekt via oa:Annotation met motivatie oa:classifying die twee bodies heeft:
1) Een skos:Concept uit de SDG codelijst (sdg-simple) dat matcht met het gevraagde thema
2) De impact-URI (positief/negatief/neutraal/onbekend)
De annotatie-target is de eli:Expression, die via eli:is_realized_by aan het eli:Work gekoppeld is.
Filter op gemeente via eli:passed_by -> bestuursorgaan -> euvoc:represents -> regio."""@nl ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """SELECT (COUNT(DISTINCT ?expression) AS ?aantalBesluiten) WHERE {
  ?annotation a oa:Annotation ;
    oa:motivatedBy oa:classifying ;
    oa:hasBody ?concept ;
    oa:hasBody <http://mu.semte.ch/vocabularies/ext/impact/positive> ;
    oa:hasTarget ?expression .

  ?concept a skos:Concept ;
    skos:inScheme <http://data.lblod.gift/id/conceptscheme/sdg-simple> ;
    skos:altLabel ?sdgLabel .
  FILTER(CONTAINS(LCASE(STR(?sdgLabel)), LCASE("climate")))

  ?work eli:is_realized_by ?expression ;
        eli:passed_by ?adminBody .
  ?adminBody euvoc:represents ?region .
  ?region skos:prefLabel ?regionLabel .
  FILTER(CONTAINS(LCASE(STR(?regionLabel)), LCASE("Gent")))
  FILTER(lang(?regionLabel) = "nl")
}""" ;
    schema:keywords "milieu", "climate", "SDG", "positief", "impact", "aantal", "besluiten", "Gent" ;
    schema:target <https://human-validator.decide.lblod.info/api/sparql> .

ex:005
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment """Waren er meer positieve of negatieve besluiten voor de economie in een bepaalde gemeente?
Zoekt via oa:Annotation met motivatie oa:classifying. Elke annotatie heeft twee bodies:
1) Een SDG-concept (bv. SDG-8 'Decent work and economic growth' of SDG-9 'Industry, innovation and infrastructure')
2) Een impact-concept uit de impact-codelijst (positief/negatief/neutraal/onbekend)
De impact-concepten zijn: ext:impact/positive, ext:impact/negative, ext:impact/neutral, ext:impact/unknown.
Groepeer per impact-type en tel het aantal besluiten."""@nl ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """SELECT ?impactLabel (COUNT(DISTINCT ?expression) AS ?aantalBesluiten) WHERE {
  ?annotation a oa:Annotation ;
    oa:motivatedBy oa:classifying ;
    oa:hasBody ?sdgConcept ;
    oa:hasBody ?impactConcept ;
    oa:hasTarget ?expression .

  ?sdgConcept a skos:Concept ;
    skos:inScheme <http://data.lblod.gift/id/conceptscheme/sdg-simple> ;
    skos:altLabel ?sdgLabel .
  FILTER(CONTAINS(LCASE(STR(?sdgLabel)), LCASE("economic growth"))
      || CONTAINS(LCASE(STR(?sdgLabel)), LCASE("industry")))

  ?impactConcept skos:inScheme <http://mu.semte.ch/vocabularies/ext/impact> ;
    skos:prefLabel ?impactLabel .

  ?work eli:is_realized_by ?expression ;
        eli:passed_by ?adminBody .
  ?adminBody euvoc:represents ?region .
  ?region skos:prefLabel ?regionLabel .
  FILTER(CONTAINS(LCASE(STR(?regionLabel)), LCASE("Gent")))
  FILTER(lang(?regionLabel) = "nl")
}
GROUP BY ?impactLabel
ORDER BY DESC(?aantalBesluiten)""" ;
    schema:keywords "economie", "economy", "SDG", "positief", "negatief", "impact", "vergelijking", "Gent" ;
    schema:target <https://human-validator.decide.lblod.info/api/sparql> .

ex:006
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment """Welk bestuursorgaan van een bepaalde gemeente publiceerde het meeste besluiten?
Zoekt eli:Work entiteiten gekoppeld aan bestuursorganen via eli:passed_by.
Het bestuursorgaan (org:Organization) is via euvoc:represents gekoppeld aan de gemeente/regio.
Telt het aantal unieke Works per bestuursorgaan."""@nl ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """SELECT ?adminBodyLabel (COUNT(DISTINCT ?work) AS ?aantalBesluiten) WHERE {
  ?work a eli:Work ;
        eli:passed_by ?adminBody .

  ?adminBody skos:prefLabel ?adminBodyLabel ;
             euvoc:represents ?region .
  ?region skos:prefLabel ?regionLabel .
  FILTER(CONTAINS(LCASE(STR(?regionLabel)), LCASE("Gent")))
  FILTER(lang(?regionLabel) = "nl")
  FILTER(lang(?adminBodyLabel) = "nl")
}
GROUP BY ?adminBodyLabel
ORDER BY DESC(?aantalBesluiten)
LIMIT 10""" ;
    schema:keywords "bestuursorgaan", "meeste", "besluiten", "publicatie", "Gent", "administrativeBody" ;
    schema:target <https://human-validator.decide.lblod.info/api/sparql> .

ex:007
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment """Welk bestuursorgaan had de grootste positieve impact op een bepaald thema (bv. milieu/SDG-13)?
Combineert de codelist-annotatie (oa:classifying) met impact-filtering en groepeert per bestuursorgaan.
Elke annotatie heeft twee bodies: het SDG-concept en het impact-concept (positief/negatief/neutraal/onbekend).
De annotatie-target is de eli:Expression, gekoppeld aan eli:Work via eli:is_realized_by."""@nl ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """SELECT ?adminBodyLabel (COUNT(DISTINCT ?expression) AS ?aantalBesluiten) WHERE {
  ?annotation a oa:Annotation ;
    oa:motivatedBy oa:classifying ;
    oa:hasBody ?concept ;
    oa:hasBody <http://mu.semte.ch/vocabularies/ext/impact/positive> ;
    oa:hasTarget ?expression .

  ?concept a skos:Concept ;
    skos:inScheme <http://data.lblod.gift/id/conceptscheme/sdg-simple> ;
    skos:altLabel ?sdgLabel .
  FILTER(CONTAINS(LCASE(STR(?sdgLabel)), LCASE("climate")))

  ?work eli:is_realized_by ?expression ;
        eli:passed_by ?adminBody .
  ?adminBody skos:prefLabel ?adminBodyLabel ;
             euvoc:represents ?region .
  ?region skos:prefLabel ?regionLabel .
  FILTER(CONTAINS(LCASE(STR(?regionLabel)), LCASE("Gent")))
  FILTER(lang(?regionLabel) = "nl")
  FILTER(lang(?adminBodyLabel) = "nl")
}
GROUP BY ?adminBodyLabel
ORDER BY DESC(?aantalBesluiten)
LIMIT 10""" ;
    schema:keywords "bestuursorgaan", "impact", "milieu", "climate", "SDG", "positief", "Gent" ;
    schema:target <https://human-validator.decide.lblod.info/api/sparql> .

ex:008
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment """Overzicht van positieve impact per SDG-categorie in een bepaalde gemeente.
Toont per SDG-concept hoeveel besluiten een positieve impact hadden.
Handig om te zien welke duurzaamheidsdoelen het meest positief beïnvloed worden door besluiten.
De SDG codelijst (sdg-simple) bevat 17 doelen met labels zoals 'Climate action', 'No poverty', 'Quality education', etc."""@nl ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """SELECT ?sdgLabel (COUNT(DISTINCT ?expression) AS ?aantalBesluiten) WHERE {
  ?annotation a oa:Annotation ;
    oa:motivatedBy oa:classifying ;
    oa:hasBody ?concept ;
    oa:hasBody <http://mu.semte.ch/vocabularies/ext/impact/positive> ;
    oa:hasTarget ?expression .

  ?concept a skos:Concept ;
    skos:inScheme <http://data.lblod.gift/id/conceptscheme/sdg-simple> ;
    skos:altLabel ?sdgLabel .

  ?work eli:is_realized_by ?expression ;
        eli:passed_by ?adminBody .
  ?adminBody euvoc:represents ?region .
  ?region skos:prefLabel ?regionLabel .
  FILTER(CONTAINS(LCASE(STR(?regionLabel)), LCASE("Gent")))
  FILTER(lang(?regionLabel) = "nl")
}
GROUP BY ?sdgLabel
ORDER BY DESC(?aantalBesluiten)""" ;
    schema:keywords "SDG", "overzicht", "alle", "categorie", "positief", "impact", "Gent", "duurzaamheid" ;
    schema:target <https://human-validator.decide.lblod.info/api/sparql> .

ex:009
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment """Lijst alle beschikbare codelijsten (ConceptSchemes) met hun labels.
Toont welke codelijsten beschikbaar zijn voor annotaties, bv. 'Sustainable Development Goals', 'Impact', 'Restricted Mobility Zones'."""@nl ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """SELECT DISTINCT ?scheme ?schemeLabel WHERE {
  ?scheme a skos:ConceptScheme .
  OPTIONAL { ?scheme skos:prefLabel ?schemeLabel }
}
ORDER BY ?schemeLabel""" ;
    schema:keywords "codelijst", "conceptscheme", "lijst", "beschikbaar", "overzicht" ;
    schema:target <https://human-validator.decide.lblod.info/api/sparql> .

ex:010
    a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment """Lijst alle concepten van een bepaalde codelijst (bv. SDG-simple) met hun labels en nummering.
Toont de beschikbare categorieën waarop besluiten geclassificeerd kunnen worden."""@nl ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """SELECT ?concept ?notation ?prefLabel ?altLabel WHERE {
  ?concept a skos:Concept ;
    skos:inScheme <http://data.lblod.gift/id/conceptscheme/sdg-simple> ;
    skos:prefLabel ?prefLabel .
  OPTIONAL { ?concept skos:notation ?notation }
  OPTIONAL { ?concept skos:altLabel ?altLabel }
}
ORDER BY ?notation""" ;
    schema:keywords "concept", "SDG", "codelijst", "categorieën", "labels", "overzicht" ;
    schema:target <https://human-validator.decide.lblod.info/api/sparql> .
