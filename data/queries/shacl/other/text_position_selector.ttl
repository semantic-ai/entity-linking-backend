@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mu: <http://mu.semte.ch/vocabularies/core/> .
@prefix oa: <http://www.w3.org/ns/oa#> .

<http://example.org/text_position_selector_1_shape>
    a sh:NodeShape ;
    sh:targetClass <http://www.w3.org/ns/oa#TextPositionSelector> ;
    sh:prefixes [ sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://mu.semte.ch/vocabularies/core/"^^xsd:anyURI ;
        sh:prefix "mu" ;
    ] ], [ sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://www.w3.org/ns/oa#"^^xsd:anyURI ;
        sh:prefix "oa" ;
    ] ];
    sh:property [
        sh:path mu:uuid ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:name "start" ;
        sh:description "De startpositie (character offset) in de brontekst." ;
        sh:path oa:start ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
    ] ;
    sh:property [
        sh:name "einde" ;
        sh:description "De eindpositie (character offset) in de brontekst." ;
        sh:path oa:end ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
    ] .
