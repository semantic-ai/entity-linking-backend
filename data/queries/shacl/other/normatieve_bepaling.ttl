@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mu: <http://mu.semte.ch/vocabularies/core/> .
@prefix dct: <http://purl.org/dc/terms/> .

<http://example.org/normatieve_bepaling_1_shape>
    a sh:NodeShape ;
    sh:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#NormatieveBepaling> ;
    sh:prefixes [ sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://mu.semte.ch/vocabularies/core/"^^xsd:anyURI ;
        sh:prefix "mu" ;
    ] ], [ sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "https://data.vlaanderen.be/ns/omgevingsvergunning#"^^xsd:anyURI ;
        sh:prefix "omg" ;
    ] ], [ sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ;
        sh:prefix "dct" ;
    ] ], [ sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://www.w3.org/2006/time#"^^xsd:anyURI ;
        sh:prefix "time" ;
    ] ];
    sh:property [
        sh:path mu:uuid ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:name "geldigheidsperiode" ;
        sh:description "De geldigheidsperiode (time:ProperInterval) van de normatieve bepaling." ;
        sh:path dct:extent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] .
